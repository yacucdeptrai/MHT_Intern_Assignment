{
  "name": "@pm/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "react-router build && vite preview",
    "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b",
    "cf-typegen": "wrangler types --env-file .dev.vars.example",
    "postinstall": "pnpm run cf-typegen",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc --env",
    "deploy:built": "wrangler deploy"
  },
  "dependencies": {
    "@pm/db": "workspace:*",
    "@pm/domain": "workspace:*",
    "i18next": "27.2.1",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "18.0.2",
    "react-router": "^8.5.1",
    "remix-auth": "^4.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/fs-routes": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}

# Local Worker variables for `pnpm dev` / `pnpm preview` (Wrangler reads apps/web/.dev.vars).
# Copy this file to apps/web/.dev.vars and fill the values. Never commit .dev.vars.
# Every key here is documented in docs/08-dev-environment-and-deployment.md §4.2
# and in docs/environment-setup.md (how to obtain each value).

# --- Required ---------------------------------------------------------------
APP_ENV=local
APP_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=console

# At least 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-with-32-random-bytes-base64

# First Admin account created by `pnpm db:seed:local`
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=replace-with-a-strong-password

# --- Optional: SSO (buttons are hidden when empty) -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional: Slack (jobs end SKIPPED when empty) --------------------------
SLACK_BOT_TOKEN=

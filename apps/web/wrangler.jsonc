// Worker configuration (docs/08-dev-environment-and-deployment.md §4.1).
// Top level = local development. Remote environments repeat every binding, because
// Wrangler does not inherit bindings or vars into `env.*` blocks.
// Replace each REPLACE_WITH_* database_id with the id printed by `wrangler d1 create pm-<env>`
// (docs/environment-setup.md §2). Database ids are not secret.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pm-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pm-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "pm-local" }],
  "durable_objects": { "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "UserNotificationHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserNotificationHub"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_ENV": "local",
    "APP_BASE_URL": "http://localhost:5173",
    "EMAIL_PROVIDER": "console",
  },
  "env": {
    "dev": {
      "name": "pm-dev",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pm-dev",
          "database_id": "REPLACE_WITH_PM_DEV_DATABASE_ID",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "pm-dev" }],
      "durable_objects": { "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "UserNotificationHub" }] },
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "APP_ENV": "dev",
        "APP_BASE_URL": "https://pm-dev.REPLACE_WITH_SUBDOMAIN.workers.dev",
        "EMAIL_PROVIDER": "console",
      },
    },
    "staging": {
      "name": "pm-staging",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pm-staging",
          "database_id": "REPLACE_WITH_PM_STAGING_DATABASE_ID",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "pm-staging" }],
      "durable_objects": { "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "UserNotificationHub" }] },
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://pm-staging.REPLACE_WITH_SUBDOMAIN.workers.dev",
        "EMAIL_PROVIDER": "console",
      },
    },
    "production": {
      "name": "pm-production",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pm-production",
          "database_id": "REPLACE_WITH_PM_PRODUCTION_DATABASE_ID",
          "migrations_dir": "../../packages/db/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "pm-production" }],
      "durable_objects": { "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "UserNotificationHub" }] },
      "triggers": { "crons": ["*/5 * * * *"] },
      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://pm-production.REPLACE_WITH_SUBDOMAIN.workers.dev",
        "EMAIL_PROVIDER": "console",
      },
    },
  },
}
